---
// Photos.astro
interface PhotoEntry {
  id: string
  title: string
  description: string
  date: string
  emoji?: string
  images: string[] // 图片 URL 数组
}

interface Props {
  entries: PhotoEntry[]
  title?: string
  subtitle?: string
}

const { entries, title = 'Photos', subtitle = 'Here I will record some photos taken in daily life.' } = Astro.props
---

<div class="photos-container">
  <header class="photos-header">
    <h1>{title}</h1>
    <p>{subtitle}</p>
  </header>

  <div class="photo-entries">
    {
      entries.map((entry) => (
        <article class="photo-entry">
          <div class="entry-header">
            <div class="entry-title">
              {entry.emoji && <span class="emoji">{entry.emoji}</span>}
              <h2>{entry.title}</h2>
            </div>
            <time class="entry-date">{entry.date}</time>
          </div>

          <p class="entry-description">{entry.description}</p>

          <div class="photo-strip">
            {entry.images.map((img, index) => (
              <div
                class="polaroid"
                style={`transform: rotate(${index % 2 === 0 ? '-' : ''}${3 + (index % 4)}deg); z-index: ${index};`}
              >
                <img src={img} alt={`${entry.title} photo ${index + 1}`} loading="lazy" />
                <div class="polaroid-shadow" />
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  .photos-container {
    background: #0f0f12;
    color: #e5e5e5;
    min-height: 100vh;
    padding: 2rem 1rem;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
  }

  .photos-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .photos-header h1 {
    font-size: 2.8rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(90deg, #a78bfa, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .photos-header p {
    color: #a1a1aa;
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .photo-entries {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .photo-entry {
    background: #18181b;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s ease;
  }

  .photo-entry:hover {
    transform: translateY(-4px);
  }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .entry-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .emoji {
    font-size: 1.8rem;
  }

  .entry-title h2 {
    font-size: 1.5rem;
    margin: 0;
    color: #f4f4f5;
  }

  .entry-date {
    color: #71717a;
    font-size: 0.95rem;
    font-family: monospace;
    white-space: nowrap;
  }

  .entry-description {
    color: #d4d4d8;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 800px;
  }

  .photo-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: flex-start;
    padding: 20px 10px;
    background: #27272a;
    border-radius: 12px;
    position: relative;
  }

  .polaroid {
    width: 180px;
    background: white;
    padding: 12px 12px 28px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
  }

  .polaroid:hover {
    transform: scale(1.08) rotate(0deg) !important;
    z-index: 100;
  }

  .polaroid img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    background: #111;
  }

  .polaroid-shadow {
    height: 6px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.15));
    margin-top: 8px;
    border-radius: 50%;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .polaroid {
      width: 150px;
    }

    .polaroid img {
      height: 150px;
    }
  }

  /* Film strip effect */
  .photo-strip::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 4px;
    background: repeating-linear-gradient(90deg, #3f3f46, #3f3f46 20px, transparent 20px, transparent 40px);
    opacity: 0.6;
  }
</style>
