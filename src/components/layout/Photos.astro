---
import type { InspirationPhoto, JournalGroup } from '@/data/photos'

interface Props {
  inspirationPhotos: InspirationPhoto[]
  journalGroups: JournalGroup[]
}

const { inspirationPhotos, journalGroups } = Astro.props
---

<section class="photos-page">
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <header class="photos-hero">
    <span class="eyebrow">Visual diary</span>
    <h1>Photos</h1>
    <p>Fragments of light, places, and ordinary days worth keeping.</p>
  </header>

  <section class="inspiration-section" aria-labelledby="inspiration-title">
    <div class="section-heading">
      <span class="section-kicker">Network images</span>
      <h2 id="inspiration-title">Inspiration wall</h2>
      <p>Reference images, visual moods, and borrowed light gathered from the web.</p>
    </div>

    <div class="inspiration-grid">
      {
        inspirationPhotos.map((photo, index) => (
          <article class="inspiration-card" style={`--card-index: ${index}; --accent: ${photo.accent};`}>
            <img src={photo.image} alt={photo.title} loading="lazy" />
            <div class="inspiration-overlay">
              <span>{photo.source}</span>
              <h3>{photo.title}</h3>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="journal-section" aria-labelledby="journal-title">
    <div class="section-heading compact">
      <span class="section-kicker">Personal archive</span>
      <h2 id="journal-title">Photo journal</h2>
      <p>My own photos, grouped by day and arranged as small memory stacks.</p>
    </div>

    <div class="timeline" aria-label="Photo timeline">
      {
        journalGroups.map((group, groupIndex) => (
          <article class="entry" style={`--entry-index: ${groupIndex};`}>
            <div class="rail" aria-hidden="true">
              <span class="icon">{group.icon.fallback ?? group.icon.value}</span>
              <span class="line" />
            </div>

            <div class="content">
              <div class="meta">
                <div>
                  <span class="date">{group.date}</span>
                  <h3 class="title">
                    {group.location && <span>{group.location} · </span>}
                    {group.title}
                  </h3>
                </div>
                <span class="count">{group.images.length.toString().padStart(2, '0')} frames</span>
              </div>

              <p class="desc">{group.description}</p>

              <div class="stack">
                {group.images.map((image, index) => (
                  <figure
                    class="polaroid"
                    style={`--rotate: ${(index % 2 === 0 ? -1 : 1) * (4 + index * 1.8)}deg; --lift: ${index * 10}px; --z: ${20 - index}; --spread: ${index * 7}px;`}
                  >
                    <img src={image} alt={`${group.title} photo ${index + 1}`} loading="lazy" />
                  </figure>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</section>

<style>
  .photos-page {
    position: relative;
    isolation: isolate;
    max-width: 1080px;
    min-height: 100vh;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) clamp(18px, 4vw, 36px) clamp(80px, 10vw, 120px);
    overflow: hidden;
    color: #f5f1e8;
    border-radius: 32px;
    background:
      radial-gradient(circle at 18% 8%, rgba(255, 214, 165, 0.2), transparent 32%),
      radial-gradient(circle at 82% 18%, rgba(144, 178, 255, 0.16), transparent 30%),
      linear-gradient(135deg, #15120f 0%, #0f1218 48%, #11100e 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .photos-page::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.34;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 88%);
  }

  .photos-page::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.22;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .ambient {
    position: absolute;
    z-index: -1;
    width: 320px;
    height: 320px;
    border-radius: 999px;
    filter: blur(44px);
    opacity: 0.5;
    animation: drift 10s ease-in-out infinite alternate;
  }

  .ambient-one {
    top: 120px;
    left: -150px;
    background: rgba(255, 180, 105, 0.24);
  }

  .ambient-two {
    right: -140px;
    bottom: 180px;
    background: rgba(116, 151, 255, 0.22);
    animation-delay: -4s;
  }

  .photos-hero {
    max-width: 740px;
    margin-bottom: clamp(52px, 8vw, 82px);
    animation: rise-in 0.8s ease both;
  }

  .eyebrow,
  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(245, 241, 232, 0.62);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin-bottom: 16px;
  }

  .eyebrow::before,
  .section-kicker::before {
    content: '';
    width: 32px;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 218, 165, 0.85), transparent);
  }

  .photos-hero h1 {
    margin: 0;
    font-size: clamp(4rem, 13vw, 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.08em;
    color: transparent;
    background: linear-gradient(115deg, #fff8e8 0%, #e9c891 42%, #9db6ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    text-shadow: 0 30px 70px rgba(0, 0, 0, 0.34);
  }

  .photos-hero p,
  .section-heading p {
    max-width: 560px;
    color: rgba(245, 241, 232, 0.62);
    line-height: 1.8;
  }

  .photos-hero p {
    margin: 24px 0 0;
    font-size: clamp(1rem, 2vw, 1.18rem);
  }

  .inspiration-section {
    margin-bottom: clamp(68px, 10vw, 112px);
  }

  .section-heading {
    display: grid;
    gap: 12px;
    margin-bottom: 28px;
  }

  .section-heading.compact {
    margin-bottom: 34px;
  }

  .section-heading h2 {
    margin: 0;
    color: #fff9eb;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .section-heading p {
    margin: 0;
    font-size: 0.98rem;
  }

  .inspiration-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1fr;
    grid-auto-rows: 170px;
    gap: 14px;
  }

  .inspiration-card {
    position: relative;
    overflow: hidden;
    min-height: 170px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow:
      0 22px 54px rgba(0, 0, 0, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    animation: rise-in 0.7s ease both;
    animation-delay: calc(var(--card-index) * 90ms);
  }

  .inspiration-card:nth-child(1) {
    grid-row: span 2;
  }

  .inspiration-card:nth-child(3) {
    grid-column: span 1;
    grid-row: span 2;
  }

  .inspiration-card:nth-child(4) {
    grid-column: span 2;
  }

  .photos-page .inspiration-card img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04) brightness(0.88);
    transform: scale(1.02);
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.8s ease;
  }

  .inspiration-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at 20% 0%, color-mix(in srgb, var(--accent), transparent 68%), transparent 45%),
      linear-gradient(to top, rgba(0, 0, 0, 0.64), transparent 58%);
  }

  .inspiration-overlay {
    position: absolute;
    inset: auto 18px 18px;
    z-index: 2;
  }

  .inspiration-overlay span {
    color: rgba(255, 249, 235, 0.62);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .inspiration-overlay h3 {
    margin: 6px 0 0;
    color: #fff9eb;
    font-size: clamp(1.1rem, 2.4vw, 1.55rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .photos-page .inspiration-card:hover img {
    filter: saturate(1.04) contrast(1.06) brightness(0.96);
    transform: scale(1.08);
  }

  .timeline {
    display: grid;
    gap: 28px;
  }

  .entry {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: clamp(16px, 3vw, 28px);
    animation: rise-in 0.7s ease both;
    animation-delay: calc(var(--entry-index) * 120ms);
  }

  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(16px);
  }

  .line {
    width: 1px;
    min-height: 100%;
    margin-top: 12px;
    background: linear-gradient(to bottom, rgba(255, 231, 191, 0.42), rgba(255, 255, 255, 0.04));
  }

  .content {
    position: relative;
    padding: clamp(22px, 4vw, 34px);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.115), rgba(255, 255, 255, 0.045));
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(18px);
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease;
  }

  .content::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at 24% 0%, rgba(255, 217, 167, 0.16), transparent 34%);
    transition: opacity 0.35s ease;
  }

  .content:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 231, 191, 0.22);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
  }

  .content:hover::before {
    opacity: 1;
  }

  .meta {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    align-items: flex-start;
  }

  .date,
  .count {
    color: rgba(245, 241, 232, 0.48);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .count {
    white-space: nowrap;
  }

  .title {
    margin: 8px 0 0;
    color: #fff9eb;
    font-size: clamp(1.35rem, 3vw, 2.15rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .title span {
    color: #e7bf7c;
  }

  .desc {
    position: relative;
    max-width: 670px;
    margin: 18px 0 30px;
    color: rgba(245, 241, 232, 0.62);
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .stack {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-height: 220px;
    padding: 18px 0 34px 8px;
    overflow-x: auto;
    overflow-y: visible;
    perspective: 900px;
    scrollbar-width: thin;
    scrollbar-color: rgba(245, 241, 232, 0.28) transparent;
  }

  .stack::-webkit-scrollbar {
    height: 6px;
  }

  .stack::-webkit-scrollbar-track {
    background: transparent;
  }

  .stack::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.24);
  }

  .polaroid {
    position: relative;
    z-index: var(--z);
    flex: 0 0 auto;
    margin: 0 -42px 0 0;
    padding: 9px 9px 28px;
    border-radius: 5px;
    background: linear-gradient(180deg, #fffdf6, #e9e2d5);
    box-shadow:
      0 20px 34px rgba(0, 0, 0, 0.32),
      0 2px 2px rgba(255, 255, 255, 0.6) inset;
    transform: translateY(var(--lift)) rotate(var(--rotate));
    transform-origin: 50% 100%;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s ease,
      filter 0.5s ease;
  }

  .polaroid::after {
    content: '';
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 12px;
    height: 2px;
    border-radius: 999px;
    background: rgba(26, 22, 18, 0.08);
  }

  .polaroid img {
    display: block;
    width: clamp(128px, 18vw, 176px);
    height: clamp(154px, 21vw, 210px);
    object-fit: cover;
    border-radius: 2px;
    background: #17130f;
    filter: saturate(0.9) contrast(1.06) brightness(0.98);
  }

  .stack:hover .polaroid {
    transform: translate3d(var(--spread), var(--lift), 0) rotate(calc(var(--rotate) * 0.82));
  }

  .polaroid:hover {
    z-index: 200 !important;
    cursor: pointer;
    filter: saturate(1.05) brightness(1.02);
    box-shadow:
      0 30px 50px rgba(0, 0, 0, 0.44),
      0 2px 2px rgba(255, 255, 255, 0.75) inset;
    transform: translate3d(var(--spread), calc(var(--lift) - 16px), 36px) rotate(calc(var(--rotate) * 0.18))
      scale(1.055);
  }

  .stack:hover .polaroid:not(:hover) {
    filter: saturate(0.9) brightness(0.95);
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(28px, -18px, 0) scale(1.08);
    }
  }

  @media (max-width: 820px) {
    .inspiration-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 160px;
    }

    .inspiration-card:nth-child(1),
    .inspiration-card:nth-child(3),
    .inspiration-card:nth-child(4) {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 720px) {
    .photos-page {
      border-radius: 22px;
    }

    .entry {
      grid-template-columns: 32px minmax(0, 1fr);
    }

    .icon {
      width: 32px;
      height: 32px;
      font-size: 0.95rem;
    }

    .meta {
      flex-direction: column;
      gap: 10px;
    }

    .stack {
      min-height: 190px;
      overflow-x: auto;
      padding-bottom: 34px;
      scrollbar-width: none;
    }

    .stack::-webkit-scrollbar {
      display: none;
    }

    .polaroid {
      margin-right: -34px;
    }
  }

  @media (max-width: 560px) {
    .inspiration-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
